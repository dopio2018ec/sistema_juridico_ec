# Copiar este archivo como .env y ajustar los valores. No subir .env al repositorio.

APP_ENV=local
APP_DEBUG=true
APP_NAME="Sistema Juridico Ecuador"
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Guayaquil
APP_KEY=cambiar_por_una_cadena_aleatoria_de_al_menos_32_caracteres

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistema_juridico_ec
DB_USERNAME=sistema_juridico_app
DB_PASSWORD=cambiar_esta_contrasena

SESSION_NAME=sjec_session
SESSION_LIFETIME_MINUTES=20
SESSION_ABSOLUTE_LIFETIME_MINUTES=480
SESSION_SECURE_COOKIE=false

LOG_LEVEL=debug
LOG_PATH=storage/logs/app.log

LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15
