RewriteEngine On

# Bloquear acceso directo a archivos sensibles dentro de public/
<FilesMatch "\.(env|sql|log|md)$">
    Require all denied
</FilesMatch>

# Enrutar todo a index.php salvo archivos y directorios existentes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

Options -Indexes
